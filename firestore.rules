rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دوال مساعدة
    function isLoggedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return getUserRole() in ['admin', 'superAdmin']; }
    function isApproved() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // المستخدمون
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow create: if isLoggedIn();
      allow delete: if isAdmin();
    }

    // الطلبات
    match /service_requests/{requestId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && isApproved() &&
                       request.resource.data.requesterId == request.auth.uid;
      allow update: if isAdmin() ||
                      (isOwner(resource.data.assignedTo)); 
      allow delete: if isAdmin();
    }

    // التبرعات
    match /donations/{donationId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && isApproved();
      allow update, delete: if isAdmin();
    }

    // المشاريع
    match /projects/{projectId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // الإشعارات
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isLoggedIn();
    }

    // المحادثات
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isLoggedIn();
    }
    match /chats/{chatId} {
      allow read, write: if isLoggedIn();
    }

    // الإعدادات العامة
    match /service_types/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /task_types/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
