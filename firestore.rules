rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── دوال مساعدة ───────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function hasAdditionalRole(roleName) {
      let data = getUserData();
      return 'additionalRoles' in data && data.additionalRoles is list && roleName in data.additionalRoles;
    }

    function isDonor() {
      return getRole() == 'donor' || hasAdditionalRole('canDonate');
    }

    function isBeneficiary() {
      return getRole() == 'beneficiary' || hasAdditionalRole('canRequestService');
    }

    function isWorker() {
      return getRole() == 'worker';
    }

    function isAdmin() {
      return isLoggedIn() && (getRole() in ['admin', 'superAdmin', 'superadmin']);
    }

    function isSuperAdmin() {
      return isLoggedIn() && (getRole() in ['superAdmin', 'superadmin']);
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function ownerSafeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'phone',
        'wilaya',
        'commune',
        'address',
        'profileImage',
        'bloodType',
        'receiveBloodAlerts',
        'isDonorAvailable',
        'isAvailable',
        'lastActivity',
        'fcmToken',
        'fcmTokens',
        'lastTokenUpdate',
        'userId',
        'notes',
        'activeBloodRequestId',
      ]);
    }

    function workerSafeRequestUpdate() {
      return resource.data.assignedTo == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'completedAt',
        ]);
    }

    function requesterSafeRequestUpdate() {
      return resource.data.requesterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating',
          'ratingComment',
          'ratedAt',
          'updatedAt',
        ]);
    }

    function donorSafeRequestResponseUpdate() {
      return isLoggedIn() &&
        resource.data.status in ['pending', 'in_progress'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'donorResponses',
          'assignedTo',
          'status',
          'updatedAt',
        ]);
    }

    function getUserRoleById(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdminRoleName(roleName) {
      return roleName in ['admin', 'superAdmin', 'superadmin'];
    }

    function isAdminUser(uid) {
      return isAdminRoleName(getUserRoleById(uid));
    }

    function hasTwoParticipants(data) {
      return data.participants is list &&
        data.participants.size() == 2 &&
        data.participants[0] != data.participants[1];
    }

    function isValidPrivateChatId(chatId, data) {
      return hasTwoParticipants(data) && (
        chatId == data.participants[0] + '_' + data.participants[1] ||
        chatId == data.participants[1] + '_' + data.participants[0]
      );
    }

    function privateCounterpartyIsAdmin(data) {
      return hasTwoParticipants(data) && (
        (data.participants[0] == request.auth.uid && isAdminUser(data.participants[1])) ||
        (data.participants[1] == request.auth.uid && isAdminUser(data.participants[0]))
      );
    }

    function canAccessGroupChatData(chatId, data) {
      return data.type == 'group' &&
        data.participants is list &&
        request.auth.uid in data.participants &&
        (
          (chatId == 'group_team' && (isWorker() || getRole() == 'chatModerator' || isAdmin())) ||
          (chatId == 'group_management' && isAdmin())
        );
    }

    function canAccessPrivateChatData(data) {
      return data.type == 'private' &&
        hasTwoParticipants(data) &&
        request.auth.uid in data.participants &&
        (
          isAdmin() ||
          (
            (isWorker() || getRole() == 'chatModerator' || isDonor() || isBeneficiary()) &&
            privateCounterpartyIsAdmin(data)
          )
        );
    }

    function canAccessChatData(chatId, data) {
      return isLoggedIn() && (
        isAdmin() ||
        canAccessPrivateChatData(data) ||
        canAccessGroupChatData(chatId, data)
      );
    }

    function canCreatePrivateChat(chatId, data) {
      return data.type == 'private' &&
        hasTwoParticipants(data) &&
        request.auth.uid in data.participants &&
        isValidPrivateChatId(chatId, data) &&
        (
          getRole() in ['worker', 'chatModerator', 'donor', 'beneficiary'] &&
          privateCounterpartyIsAdmin(data)
        );
    }

    function canCreateGroupChat(chatId, data) {
      return data.type == 'group' &&
        data.participants is list &&
        request.auth.uid in data.participants &&
        chatId == 'group_team' &&
        getRole() in ['worker', 'chatModerator'];
    }

    function canAccessExistingChat(chatId) {
      return canAccessChatData(chatId, resource.data);
    }

    function canReadChatData(data) {
      return isLoggedIn() && (
        isAdmin() ||
        (data.participants is list && request.auth.uid in data.participants)
      );
    }

    function canReadExistingChat(chatId) {
      return canReadChatData(resource.data);
    }

    function canReadChatById(chatId) {
      return canReadChatData(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function canAccessChatById(chatId) {
      return canAccessChatData(chatId, get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function nonAdminChatUpdateSafe(chatId) {
      return canAccessChatData(chatId, request.resource.data) &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.participants is list &&
        resource.data.participants is list &&
        request.resource.data.participants.size() == resource.data.participants.size() &&
        request.resource.data.participants.hasAll(resource.data.participants);
    }

    // ─── المستخدمون ───────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin() || (isLoggedIn() && resource.data.role in ['admin', 'superAdmin', 'superadmin']);
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['beneficiary', 'worker', 'donor', 'chatModerator'] &&
        request.resource.data.isApproved == false;
      allow update: if isSuperAdmin() || 
                       (isAdmin() && resource.data.role != 'superAdmin' && resource.data.role != 'superadmin' && request.resource.data.role != 'superAdmin' && request.resource.data.role != 'superadmin') || 
                       (isOwner(userId) && ownerSafeUserUpdate());
      allow delete: if isSuperAdmin();
    }

    // ─── الإشعارات ──────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if isLoggedIn() && (
        resource.data.userId       == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetRole   == 'all' ||
        resource.data.targetRole   == getRole() ||
        (resource.data.targetRole == 'donor' && isDonor()) ||
        (resource.data.targetRole == 'beneficiary' && isBeneficiary()) ||
        isAdmin()
      );
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.userId       == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']))
      );
      allow delete: if isAdmin();
    }

    // ─── أنواع الخدمات ────────────────────────────────────
    match /service_types/{typeId} {
      allow read:   if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── طلبات الخدمة ────────────────────────────────────
    match /service_requests/{reqId} {
      allow read: if isLoggedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.assignedTo  == request.auth.uid ||
        isAdmin() ||
        resource.data.type in ['blood_donation', 'blood_emergency']
      );
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        isAdmin() ||
        workerSafeRequestUpdate() ||
        requesterSafeRequestUpdate() ||
        donorSafeRequestResponseUpdate()
      );
      allow delete: if isSuperAdmin();

      // يسمح للمتطوع المسند إليه الطلب أو المدير بإضافة تحديثات
      match /updates/{updateId} {
        allow read: if isLoggedIn() && (
          get(/databases/$(database)/documents/service_requests/$(reqId)).data.requesterId == request.auth.uid ||
          get(/databases/$(database)/documents/service_requests/$(reqId)).data.assignedTo == request.auth.uid ||
          isAdmin()
        );
        allow create: if isLoggedIn() && (
          get(/databases/$(database)/documents/service_requests/$(reqId)).data.assignedTo == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ─── التبرعات ─────────────────────────────────────────
    match /donations/{donId} {
      allow read:          if isLoggedIn() && (
        resource.data.donorId == request.auth.uid || isAdmin()
      );
      allow create:        if isLoggedIn();
      allow update:        if isAdmin();
      allow delete:        if isSuperAdmin();
    }

    // ─── المشاريع ─────────────────────────────────────────
    match /projects/{projectId} {
      allow read:          if true;
      allow create:        if isAdmin();
      allow delete:        if isSuperAdmin();
      allow update:        if isAdmin() || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collected', 'donorsCount', 'status', 'completedAt']));

      match /updates/{updateId} {
        allow read:   if true;
        allow create: if isLoggedIn();
        allow update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ─── الدردشة ──────────────────────────────────────────
    match /chats/{chatId} {
      allow read:         if isLoggedIn() && (
        isAdmin() ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants)
      );
      allow create:       if isLoggedIn() && (
        isAdmin() ||
        canCreatePrivateChat(chatId, request.resource.data) ||
        canCreateGroupChat(chatId, request.resource.data)
      );
      allow update:       if isAdmin() ||
        (canAccessExistingChat(chatId) && nonAdminChatUpdateSafe(chatId)) ||
        canCreatePrivateChat(chatId, request.resource.data);
      allow delete:       if isSuperAdmin();

      match /messages/{messageId} {
        allow read:          if canReadChatById(chatId);
        allow create:        if canAccessChatById(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.chatId == chatId;
        allow update:        if isLoggedIn() && (
          isAdmin() ||
          (
            canAccessChatById(chatId) &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.chatId == chatId &&
            (
              resource.data.senderId == request.auth.uid ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'isRead'])
            )
          )
        );
        allow delete:        if isLoggedIn() && (
          isAdmin() ||
          (resource.data.senderId == request.auth.uid && canAccessChatById(chatId))
        );
      }
    }

    // ─── إعدادات التطبيق والسيارات والمهام المخصصة ────────────
    match /app_config/{docId} {
      allow read:  if isLoggedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /vehicles/{docId} {
      allow read:  if isLoggedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /task_types/{docId} {
      allow read:  if isLoggedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /blood_requests/{docId} {
      allow read:  if isAdmin() || (isLoggedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isLoggedIn() && (
        isAdmin() || request.resource.data.requesterId == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── الإحصائيات والتحديثات المباشرة ──────────────────────
    match /stats/{statId} {
      allow read, list: if isLoggedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /worker_updates/{updateId} {
      allow read, list: if isLoggedIn();
      allow create: if isLoggedIn() && (getRole() == 'worker' || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── إدارة دار السبيل ──────────────────────────────────
    match /dar_sabil_mgmt/{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── البث العام التفاعلي (Broadcasts) ───────────────────
    match /broadcasts/{broadcastId} {
      allow read:   if isLoggedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || 
        (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'viewedByUserIds']));
    }

    // ─── تقييمات التطبيق (App Reviews) ─────────────────────
    match /app_reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── البيانات الوصفية (Counters and Metadata) ────────────
    match /metadata/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
